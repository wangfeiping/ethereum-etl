# 转账交易流式处理 Docker 环境变量配置
# 复制此文件为 .env 并根据需要修改

# Web3 提供者配置
PROVIDER_URI=

# 区块同步配置
START_BLOCK=9088000
PERIOD_SECONDS=10
BATCH_SIZE=100
MAX_WORKERS=5
LAG=0

# 文件路径配置
OUTPUT_FILE=/apps/ethereum-etl/data/transfer_transactions.csv
LOG_FILE=/apps/ethereum-etl/logs/transfer_stream.log
PID_FILE=/apps/ethereum-etl/state/transfer_stream.pid
LAST_SYNCED_BLOCK_FILE=/apps/ethereum-etl/state/last_synced_transfer_block.txt

# 导出选项
EXPORT_BLOCKS=false
EXPORT_TRANSACTIONS=true

# 可选：数据库输出配置
# OUTPUT_FILE=postgresql+pg8000://user:pass@localhost/ethereum

# 可选：Kafka输出配置
# OUTPUT_FILE=kafka/127.0.0.1:9092

# 可选：Google Cloud Storage输出配置
# OUTPUT_FILE=gs://your-bucket/transfers/ 
