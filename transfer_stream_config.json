{
  "development": {
    "provider_uri": "https://mainnet.infura.io",
    "start_block": null,
    "period_seconds": 30,
    "batch_size": 10,
    "max_workers": 2,
    "lag": 0,
    "output_file": "transfer_transactions_dev.csv",
    "log_file": "transfer_stream_dev.log",
    "pid_file": "transfer_stream_dev.pid",
    "export_blocks": false,
    "export_transactions": true,
    "daemon_mode": false
  },
  "testing": {
    "provider_uri": "https://mainnet.infura.io",
    "start_block": null,
    "period_seconds": 10,
    "batch_size": 50,
    "max_workers": 3,
    "lag": 5,
    "output_file": "transfer_transactions_test.csv",
    "log_file": "transfer_stream_test.log",
    "pid_file": "transfer_stream_test.pid",
    "export_blocks": false,
    "export_transactions": true,
    "daemon_mode": true
  },
  "production": {
    "provider_uri": "https://mainnet.infura.io/v3/YOUR_PROJECT_ID",
    "start_block": null,
    "period_seconds": 5,
    "batch_size": 100,
    "max_workers": 5,
    "lag": 10,
    "output_file": "/data/transfers/transfer_transactions.csv",
    "log_file": "/var/log/transfer_stream.log",
    "pid_file": "/var/run/transfer_stream.pid",
    "export_blocks": false,
    "export_transactions": true,
    "daemon_mode": true
  },
  "high_performance": {
    "provider_uri": "https://mainnet.infura.io/v3/YOUR_PROJECT_ID",
    "start_block": null,
    "period_seconds": 2,
    "batch_size": 200,
    "max_workers": 10,
    "lag": 5,
    "output_file": "/data/transfers/high_perf_transfers.csv",
    "log_file": "/var/log/transfer_stream_high_perf.log",
    "pid_file": "/var/run/transfer_stream_high_perf.pid",
    "export_blocks": false,
    "export_transactions": true,
    "daemon_mode": true
  },
  "database_output": {
    "provider_uri": "https://mainnet.infura.io/v3/YOUR_PROJECT_ID",
    "start_block": null,
    "period_seconds": 10,
    "batch_size": 100,
    "max_workers": 5,
    "lag": 5,
    "output_file": "postgresql+pg8000://user:pass@localhost/ethereum",
    "log_file": "/var/log/transfer_stream_db.log",
    "pid_file": "/var/run/transfer_stream_db.pid",
    "export_blocks": false,
    "export_transactions": true,
    "daemon_mode": true
  },
  "kafka_output": {
    "provider_uri": "https://mainnet.infura.io/v3/YOUR_PROJECT_ID",
    "start_block": null,
    "period_seconds": 5,
    "batch_size": 100,
    "max_workers": 5,
    "lag": 5,
    "output_file": "kafka/127.0.0.1:9092",
    "log_file": "/var/log/transfer_stream_kafka.log",
    "pid_file": "/var/run/transfer_stream_kafka.pid",
    "export_blocks": false,
    "export_transactions": true,
    "daemon_mode": true
  }
} 